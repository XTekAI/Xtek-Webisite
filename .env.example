# Copy to .env.local for local development. Never commit real values — .gitignore already
# ignores every .env* file.

# n8n lead webhook. Ask Lisandro for these two on a private channel (not chat/email).
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_KEY=

# Cloudflare Turnstile widget created for xtekai.com and landing.xtekai.com.
# When left empty, app/api/lead/route.ts and components/TurnstileWidget.tsx fall back to
# Cloudflare's official "always pass" test keys automatically — but only outside production
# (NODE_ENV !== 'production'), so local development and preview builds still work without a
# real widget configured.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
